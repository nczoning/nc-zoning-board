# Ignore everything in this workspace
/*

# Essential Repo Files
!/.gitignore
!/LICENSE
!/ASSETS.md
!/CHANGELOG.md
!/README.md
!/CONTRIBUTING.md
!/index.html
!/admin/
!/mods.schema.json
!/public/
!/assets/
!/.github/
!/data/
!/scripts/
!/docs/
!/test/
# Standalone comparison pages that answer one question and are kept as the
# record of how it was answered. Their DATA stays ignored below.
!/spike/
!/package.json
!/package-lock.json
!/worker/
!/robots.txt
!/sitemap.xml
!/_headers

# Large generated data files: regenerate with scripts, do not commit
data/buildings.json
data/roads.json
data/metro.json
data/landmarks.json
data/terrain_contours.json
scripts/output/
scripts/logs/
scripts/__pycache__/

# Ignore system and agent files
.agent/
.gemini/
agent-instructions.md
cp2077-location-mods-map.code-workspace
raw maps/
node_modules/
.DS_Store
Thumbs.db

# Uncompressed source GLBs: drop WolvenKit exports here for `npm run encode-meshopt`.
# Repo only commits the encoded output at assets/glb-meshopt/.
assets/glb-source/

# Source .cube for the colour-grading LUT: drop the WolvenKit .cube export
# here for `npm run build-lut`. Repo only commits the runtime asset at
# assets/data/.
assets/lut-source/

# Wrangler local dev state
worker/.wrangler/

# Route A panel bake — 22 MB, regenerate with:
#   node scripts/window_panels.js --bake
data/window-panels.bin

# The real window geometry pulled out of the meshes' GLBs — 4 MB, and the INPUT to the
# window-boxes bake (which IS committed, at data/window-boxes-*.bin).
#
# To regenerate you need WolvenKit and the game archives:
#   1. run scripts/wkit/export_glass_meshes.wscript in WolvenKit  (~25 min; ExportFiles is
#      ASYNC, so wait for the .glb count to STOP CHANGING before believing its verification)
#   2. node scripts/window_geom.js
#   3. node scripts/window_boxes.js --margin 2 --assign volume --bake --set fixed
#      node scripts/window_boxes.js --margin 2 --assign volume --bake --set vanilla
data/window-geom.json

# ?windebug point cloud — 22 MB, every one of the game's 1.7M windows coloured by whether it
# lands on one of our box faces. A diagnostic, not a runtime asset. Regenerate with:
#   node scripts/window_faces.js --bake
data/window-debug-*.bin
data/window-debug-*.json

# The real window layout, per box face — 21 MB, and the thing that will replace the procedural
# window grid. IGNORED ONLY WHILE THE FORMAT IS IN FLUX: the margin, the quantisation and the
# tile size are all still open, and re-committing a 21 MB binary on each iteration would bloat
# the history for no one's benefit. COMMIT IT once the shader consumes it and the format settles
# (window-boxes-*.bin is committed, and this belongs beside it).
#   node scripts/window_faces.js --bake
data/window-faces-*.bin
data/window-faces-*.json

# Box-cloud rebuild intermediates. All regenerable from the world dump:
#   node scripts/district_boxes.js <district>          stage 1, placements
#   node scripts/district_hull.js <district> --voxel 2 stage 2, the hull
#   node scripts/encode_hull_dds.js <district>         stage 3, the texture
# The grid is 26 MB per district and the placement dump is hundreds of MB, so
# none of it belongs in the history while the pipeline is still moving.
data/district-boxes-*.bin
data/district-boxes-*.json
data/district-hull-*.bin
data/district-hull-*.json
data/district-grid-*.bin
data/hull-assets-*.csv
data/mesh-export-list.txt
data/mesh-export-list.json
assets/dds/rebuilt/

# The generated mesh export list, 3 MB of depot paths. Rebuild with
#   node scripts/mesh_export_list.js
scripts/wkit/ncz_mesh_list.wscript

# The still-missing subset of that list. Rebuild with
#   node scripts/wkit/uncook_remaining.js
scripts/wkit/ncz_remaining.wscript

# Generated signage-emitter data (night lighting). Rebuild with
#   node scripts/extract_signage.js <districts>, then the emissive wscript + --merge
data/signage-*.json
scripts/wkit/ncz_signage_meshes.wscript

# Generated D1 seed SQL: rebuild with `node worker/scripts/import-locations.mjs`
worker/.import/

# Private keys, anywhere. worker/ is whitelisted above, so a GitHub App .pem
# dropped there would otherwise be committed. Belt and braces: keep the key
# outside the repo entirely.
*.pem
*.key
data/run-log.jsonl

# Spike inputs: one building extracted as real geometry (scripts/spike_assembly.js)
data/spike-*.bin
data/spike-*.json
# Camera-reachability verdicts and their debug payload (scripts/exposure.js)
data/exposure-*.bin
data/exposure-*.json
data/exposure-boxes-*.bin
data/exposure-boxes-*.json

# Generated LOD export list: rebuild with
#   node scripts/wkit/export_lods.js <spike json | mesh list json>
scripts/wkit/ncz_lod_meshes.wscript

# Generated missing-geometry report: rebuild with
#   node scripts/missing_geometry.js
data/missing-geometry.json
